  .hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:30px}
  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);margin-top:44px}
  .stat{background:rgba(7,27,21,.86);padding:16px 18px}
  .stat b{display:block;font-size:14.5px;letter-spacing:.01em}
  .stat i{font-style:normal;font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}

  .emblem{position:relative;aspect-ratio:1/1;display:grid;place-items:center;max-width:430px;margin-left:auto;width:100%}
  .emblem::before{content:"";position:absolute;inset:8%;border:1px dashed rgba(45,212,160,.22);border-radius:50%;animation:spin 42s linear infinite}
  .emblem::after{content:"";position:absolute;inset:20%;border:1px solid rgba(45,212,160,.12);border-radius:50%}
  .emblem .glow{position:absolute;inset:14%;background:radial-gradient(circle,rgba(19,209,146,.24),transparent 66%);filter:blur(8px)}
  .emblem svg{width:74%;height:auto;position:relative;z-index:2;filter:drop-shadow(0 0 26px rgba(19,209,146,.45))}
  .emblem .pulse{animation:pulse 4.6s ease-in-out infinite;transform-origin:center}
  .scan{position:absolute;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,rgba(125,255,200,.75),transparent);top:0;animation:scan 5.2s linear infinite;z-index:3}
  @keyframes spin{to{transform:rotate(360deg)}}
  @keyframes pulse{0%,100%{opacity:.55}50%{opacity:1}}
  @keyframes scan{0%{top:24%;opacity:0}12%{opacity:.9}88%{opacity:.9}100%{top:78%;opacity:0}}

  /* sections */
  section{padding:64px 0;position:relative;z-index:1}
  .sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:34px}
  .sec-head h2{margin:10px 0 0;font-size:clamp(27px,3.6vw,40px);letter-spacing:-.03em;line-height:1.1;font-weight:900}
  .sec-head p{margin:0;max-width:40ch;color:var(--muted);font-size:15.5px}

  .duo{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .card{background:linear-gradient(165deg,var(--panel),rgba(7,27,21,.55));border:1px solid var(--line);padding:30px 30px 32px;clip-path:var(--clip);position:relative;transition:border-color .2s,transform .2s}
  .card:hover{border-color:var(--line-strong)}
  .card .idx{font-family:var(--mono);font-size:11px;letter-spacing:.2em;color:var(--em)}
  .card h3{margin:12px 0 10px;font-size:23px;letter-spacing:-.02em}
  .card p{margin:0;color:#a9c8bc;font-size:15.5px}
  .card ul{margin:18px 0 0;padding:0;list-style:none;display:grid;gap:9px;font-size:15px;color:#c6e2d7}
  .card ul li{padding-left:22px;position:relative}
  .card ul li::before{content:"";position:absolute;left:0;top:.55em;width:8px;height:8px;background:var(--em);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)}

  /* games */
  .games{display:grid;grid-template-columns:.86fr 1.14fr;gap:20px;align-items:start}
  .chips{display:grid;gap:10px}
  .chip{display:flex;align-items:center;gap:14px;width:100%;text-align:left;background:rgba(10,32,25,.7);border:1px solid var(--line);color:var(--text);padding:14px 16px;cursor:pointer;font-family:inherit;font-size:16px;clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));transition:background .18s,border-color .18s,color .18s}
  .chip svg{width:22px;height:22px;flex:none;color:var(--em);transition:color .18s}
  .chip small{display:block;font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);transition:color .18s}
  .chip:hover{border-color:var(--line-strong);background:rgba(19,209,146,.08)}
  .chip[aria-selected="true"]{background:linear-gradient(90deg,rgba(19,209,146,.22),rgba(19,209,146,.05));border-color:var(--em);color:#fff}
  .chip[aria-selected="true"] svg{color:var(--em-hot)}
  .chip[aria-selected="true"] small{color:#a9e8cf}
  .panel{background:linear-gradient(170deg,var(--panel-2),rgba(7,27,21,.6));border:1px solid var(--line-strong);padding:30px;clip-path:var(--clip);min-height:322px;display:flex;flex-direction:column}
  .panel-fade{animation:panelIn .45s cubic-bezier(.2,.8,.2,1)}
  @keyframes panelIn{from{opacity:0;translate:0 12px;filter:blur(4px)}to{opacity:1;translate:0 0;filter:blur(0)}}
  .panel h3{margin:10px 0 8px;font-size:26px;letter-spacing:-.02em}
  .panel p{margin:0;color:#b3d2c6;font-size:15.5px;max-width:56ch}
  .panel .flow{margin:20px 0 0;padding:0;list-style:none;display:grid;gap:10px}
  .panel .flow li{display:flex;gap:12px;font-size:15px;color:#cfe9df}
  .panel .flow b{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--em);padding-top:4px;min-width:26px}
  .panel .tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:22px}
  .tag{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:#a8e6cd;border:1px solid rgba(45,212,160,.28);padding:5px 10px;background:rgba(19,209,146,.06)}

  /* rules */
  .rules{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}
  .find{grid-template-columns:repeat(3,1fr)}
  .rule{background:rgba(7,27,21,.9);padding:26px 22px}
  .rule b{display:block;font-family:var(--mono);font-size:11px;letter-spacing:.2em;color:var(--em);margin-bottom:12px}
  .rule h4{margin:0 0 8px;font-size:17px}
  .rule p{margin:0;font-size:14.5px;color:#9dbdb1}

  /* join */
  .join{display:grid;grid-template-columns:1.05fr .95fr;gap:26px;align-items:stretch;background:linear-gradient(150deg,rgba(19,209,146,.14),rgba(7,27,21,.5) 46%);border:1px solid var(--line-strong);padding:38px;clip-path:var(--clip)}
  .join h2{margin:10px 0 12px;font-size:clamp(26px,3.4vw,38px);letter-spacing:-.03em;line-height:1.1}
  .join p{margin:0;color:#b8d6ca;max-width:46ch;font-size:15.5px}
  .invite{background:#03110c;border:1px solid var(--line-strong);padding:18px;display:grid;gap:14px;align-content:start}
  .invite .mono{color:var(--muted)}
  .invite code{font-family:var(--mono);font-size:clamp(13px,1.6vw,16px);color:var(--em-hot);overflow-wrap:anywhere;display:block}
  .invite .row{display:flex;gap:10px;flex-wrap:wrap}
  .invite .btn{font-size:13.5px;padding:10px 16px}
  .steps{display:grid;gap:8px;margin:0;padding:0;list-style:none;counter-reset:s;margin-top:22px}
  .steps li{counter-increment:s;display:grid;grid-template-columns:30px 1fr;gap:10px;font-size:15px;color:#cfe9df;align-items:start}
  .steps li::before{content:counter(s,decimal-leading-zero);font-family:var(--mono);font-size:11px;color:var(--em);padding-top:4px}

  footer{border-top:1px solid var(--line);padding:30px 0 40px;position:relative;z-index:1}
  .foot{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;font-size:13.5px;color:var(--muted)}
  .foot .brand b{font-size:15px}
  .foot .brand .mark{width:28px;height:28px}

  .reveal{opacity:0;translate:0 26px;filter:blur(3px);transition:opacity .75s cubic-bezier(.2,.8,.2,1),translate .75s cubic-bezier(.2,.8,.2,1),filter .6s ease,border-color .22s,box-shadow .28s}
  .reveal.in{opacity:1;translate:0 0;filter:blur(0)}

  /* motion */
  .progress{position:fixed;top:0;left:0;height:2px;width:0;background:linear-gradient(90deg,#0a7a57,#13d192 55%,#7dffc8);box-shadow:0 0 14px rgba(19,209,146,.65);z-index:60}
  a:focus-visible,button:focus-visible{outline:2px solid var(--em);outline-offset:3px}

  .hero-copy > *{animation:rise .8s cubic-bezier(.22,.75,.2,1) both}
  .hero-copy > *:nth-child(1){animation-delay:.05s}
  .hero-copy > *:nth-child(2){animation-delay:.14s}
  .hero-copy > *:nth-child(3){animation-delay:.24s}
  .hero-copy > *:nth-child(4){animation-delay:.34s}
  .hero-copy > *:nth-child(5){animation-delay:.44s}
  @keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}

  .emblem{animation:emblemIn 1.1s cubic-bezier(.22,.75,.2,1) .1s both}
  .emblem svg{will-change:transform;transition:transform .35s cubic-bezier(.22,.75,.2,1)}
  @keyframes emblemIn{from{opacity:0;transform:scale(.88) rotate(-5deg)}to{opacity:1;transform:none}}

  .hero::after{content:"";position:absolute;inset:-8% -4%;pointer-events:none;z-index:-1;opacity:0;transition:opacity .45s ease;background:radial-gradient(420px circle at var(--mx,72%) var(--my,28%),rgba(19,209,146,.16),transparent 66%)}
  .hero:hover::after{opacity:1}

  .btn-main{position:relative;overflow:hidden}
  .btn-main::after{content:"";position:absolute;top:-10%;left:-70%;width:45%;height:120%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.6),transparent);transform:skewX(-18deg);transition:left .55s cubic-bezier(.4,0,.2,1);pointer-events:none}
  .btn-main:hover::after{left:135%}

  .card:hover{box-shadow:0 26px 60px -34px rgba(19,209,146,.55)}
  .chip[aria-selected="true"]{box-shadow:0 12px 34px -20px rgba(19,209,146,.9)}
  .panel{transition:border-color .3s}
  .panel:focus-visible{outline-color:var(--line-strong)}

  .ticker{position:relative;z-index:1;overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(7,27,21,.55);-webkit-mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent);mask-image:linear-gradient(90deg,transparent,#000 9%,#000 91%,transparent)}
  .ticker-track{display:flex;width:max-content;animation:ticker 38s linear infinite}
  .ticker:hover .ticker-track{animation-play-state:paused}
  .ticker-track span{display:flex;align-items:center;gap:22px;font-family:var(--mono);font-size:11.5px;letter-spacing:.24em;text-transform:uppercase;color:#86c3ae;padding:15px 0;white-space:nowrap}
  .ticker-track span::after{content:"";width:5px;height:5px;background:var(--em);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);opacity:.85;flex:none}
  .ticker-track b{color:var(--em-hot);font-weight:600}
  @keyframes ticker{to{transform:translateX(-50%)}}

  /* extra motion */
  body::after{content:"";position:fixed;inset:-15% -8%;pointer-events:none;z-index:0;filter:blur(26px);animation:aurora 28s ease-in-out infinite alternate;background:
    radial-gradient(34% 38% at 24% 20%,rgba(19,209,146,.14),transparent 72%),
    radial-gradient(30% 34% at 76% 66%,rgba(10,122,87,.20),transparent 74%)}
  @keyframes aurora{0%{transform:translate3d(-2%,-1%,0) scale(1)}50%{transform:translate3d(2%,2%,0) scale(1.05)}100%{transform:translate3d(-1%,3%,0) scale(1.02)}}

  .hero h1 .yx{background-size:210% 100%;animation:shine 9s ease-in-out 1.2s infinite}
  @keyframes shine{0%,58%{background-position:0% 50%}74%{background-position:100% 50%}92%,100%{background-position:0% 50%}}
  .hero h1 .search{animation:tracking 1.3s cubic-bezier(.2,.8,.2,1) .35s both}
  @keyframes tracking{from{opacity:0;letter-spacing:.5em}to{opacity:1;letter-spacing:.34em}}

  .orbit{transform-box:view-box;transform-origin:150px 150px;animation:spin 16s linear infinite}
  .orbit.rev{animation-duration:24s;animation-direction:reverse}
  .orbit circle{fill:var(--em-hot)}

  .spotlight{position:relative}
  .spotlight::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .35s ease;background:radial-gradient(240px circle at var(--sx,50%) var(--sy,0%),rgba(19,209,146,.15),transparent 70%)}
  .spotlight:hover::after{opacity:1}

  .brand .mark{transition:transform .45s cubic-bezier(.2,.8,.2,1)}
  .brand:hover .mark{transform:rotate(9deg) scale(1.05)}

  .sec-head h2{background:linear-gradient(92deg,#fff 28%,var(--em-hot) 52%,#fff 76%);background-size:220% 100%;-webkit-background-clip:text;background-clip:text;color:transparent}
  .sec-head.in h2{animation:textSweep 1.8s cubic-bezier(.2,.8,.2,1) .1s both}
  @keyframes textSweep{from{background-position:100% 50%}to{background-position:0% 50%}}

  .join{animation:breathe 7s ease-in-out infinite}
  @keyframes breathe{0%,100%{box-shadow:inset 0 0 0 1px rgba(19,209,146,.18)}50%{box-shadow:inset 0 0 46px rgba(19,209,146,.16)}}

  /* intro */
  body.intro-open{overflow:hidden}
  body.pre .hero-copy > *,body.pre .emblem{animation-play-state:paused}
  .intro{position:fixed;inset:0;z-index:100;display:grid;place-items:center;cursor:pointer;background:radial-gradient(900px 640px at 50% 40%,rgba(19,209,146,.2),transparent 70%),#04110c;transition:opacity .7s ease,filter .7s ease,transform .7s ease}
  .intro[hidden]{display:none}
  .intro.gone{opacity:0;filter:blur(16px);transform:scale(1.04);pointer-events:none}
  .intro-in{display:grid;justify-items:center;gap:10px;text-align:center;padding:30px}
  .intro-mark{width:84px;height:84px;filter:drop-shadow(0 0 30px rgba(19,209,146,.5));animation:introPop .9s cubic-bezier(.2,.8,.2,1) both}
  .intro-name{margin:4px 0 0;font-size:clamp(44px,9vw,86px);font-weight:900;letter-spacing:-.04em;line-height:1;background:linear-gradient(96deg,#eafff6,var(--em-hot) 45%,var(--em) 78%,#0a7a57);-webkit-background-clip:text;background-clip:text;color:transparent}
  .intro-name span{display:block;font-size:.34em;letter-spacing:.4em;font-weight:700;-webkit-text-stroke:1px rgba(125,255,200,.5);color:transparent;margin-top:12px;padding-left:.4em}
  .intro-sub{margin:10px 0 20px;color:#a9c8bc;font-size:14.5px;max-width:36ch}
  .intro-btn{font-size:15.5px;padding:14px 28px;animation:introPulse 2.8s ease-in-out 1.1s infinite}
  .intro-hint{margin-top:14px;font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:#6f9384}
  @keyframes introPop{from{opacity:0;transform:scale(.8) rotate(-8deg)}to{opacity:1;transform:none}}
  @keyframes introPulse{0%,100%{filter:drop-shadow(0 0 0 rgba(19,209,146,0))}50%{filter:drop-shadow(0 0 20px rgba(19,209,146,.6))}}

  @media (max-width:980px){
    .hero{grid-template-columns:1fr;padding-top:48px}
    .emblem{max-width:300px;margin:34px auto 0}
    .games,.join,.duo{grid-template-columns:1fr}
    .rules{grid-template-columns:1fr 1fr}
    .find{grid-template-columns:1fr}
  }
  @media (max-width:760px){
    body{font-size:16px}
    .nav{display:none;position:absolute;left:0;right:0;top:74px;flex-direction:column;gap:2px;background:#04120d;border-bottom:1px solid var(--line);padding:14px 20px 20px}
    .nav.open{display:flex}
    .nav a{padding:12px 0;border-bottom:1px solid rgba(45,212,160,.1)}
    .burger{display:flex}
    .head-cta{display:none}
    .stats{grid-template-columns:1fr;margin-top:32px}
    .emblem{max-width:230px}
    section{padding:48px 0}
    .join{padding:26px}
    .card,.panel{padding:24px}
  }
  @media (max-width:420px){
    .rules{grid-template-columns:1fr}
    .chip small{display:none}
  }
  @media print{
    body::before,.emblem,.scan{display:none}
    body{background:#fff;color:#04110c}
    .reveal{opacity:1;translate:0 0;filter:none}
    .site-head{position:static}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
    .reveal{opacity:1;translate:0 0;filter:none}
    .hero-copy > *,.emblem,.hero h1 .search{animation-delay:0s}
    .intro{transition:none}
