<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>YxS — Search · паблик клана и общения</title>
<meta name="description" content="YxS — Search: паблик клана и общения в Discord. Ищи тиммейтов, клан или просто друзей поиграть в Rust, CS2 и Dota 2.">
<style>
  :root{
    --ink:#04110c;
    --ink-2:#071b15;
    --panel:#0a2019;
    --panel-2:#0c2a20;
    --line:rgba(45,212,160,.16);
    --line-strong:rgba(45,212,160,.42);
    --em:#13d192;
    --em-hot:#7dffc8;
    --em-deep:#0a7a57;
    --text:#e4fbf2;
    --muted:#88ab9d;
    --mono:"Cascadia Mono","Consolas","SFMono-Regular",ui-monospace,monospace;
    --sans:"Segoe UI",system-ui,-apple-system,"Inter",Arial,sans-serif;
    --clip:polygon(0 0,calc(100% - 22px) 0,100% 22px,100% 100%,22px 100%,0 calc(100% - 22px));
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;
    background:var(--ink);
    color:var(--text);
    font-family:var(--sans);
    font-size:17px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  body::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:0;
    background:
      radial-gradient(900px 620px at 78% -10%,rgba(19,209,146,.20),transparent 70%),
      radial-gradient(700px 520px at 4% 34%,rgba(10,122,87,.20),transparent 72%),
      repeating-linear-gradient(90deg,rgba(125,255,200,.045) 0 1px,transparent 1px 96px),
      repeating-linear-gradient(0deg,rgba(125,255,200,.045) 0 1px,transparent 1px 96px);
    -webkit-mask-image:linear-gradient(#000 0%,#000 55%,transparent 100%);
    mask-image:linear-gradient(#000 0%,#000 55%,transparent 100%);
  }
  .skip{position:absolute;left:-9999px;top:0;background:var(--em);color:#03150f;padding:10px 16px;z-index:99}
  .skip:focus{left:12px;top:12px}
  a{color:inherit;text-decoration:none}
  img,svg{display:block;max-width:100%}
  .wrap{width:min(1160px,calc(100% - 40px));margin-inline:auto;position:relative;z-index:1}
  .mono{font-family:var(--mono);text-transform:uppercase;letter-spacing:.2em;font-size:11.5px;color:var(--em)}

  /* header */
  .site-head{position:sticky;top:0;z-index:40;backdrop-filter:blur(14px);background:linear-gradient(180deg,rgba(4,17,12,.92),rgba(4,17,12,.68));border-bottom:1px solid var(--line)}
  .head-in{display:flex;align-items:center;gap:26px;height:74px}
  .brand{display:flex;align-items:center;gap:12px;font-weight:900;letter-spacing:-.02em}
  .brand .mark{width:36px;height:36px;flex:none}
  .brand b{font-size:19px}
  .brand span{font-family:var(--mono);font-size:11px;letter-spacing:.18em;color:var(--muted);text-transform:uppercase;display:block;line-height:1}
  .brand-name{display:grid;gap:4px}
  .nav{display:flex;gap:26px;margin-left:auto;font-size:14.5px;color:#b6d2c7}
  .nav a{position:relative;padding:6px 0;transition:color .18s}
  .nav a::after{content:"";position:absolute;left:0;right:100%;bottom:0;height:2px;background:var(--em);transition:right .22s}
  .nav a:hover,.nav a:focus-visible{color:var(--em-hot)}
  .nav a:hover::after,.nav a:focus-visible::after{right:0}
  .btn{display:inline-flex;align-items:center;gap:10px;font-weight:700;font-size:14.5px;padding:12px 22px;border:1px solid transparent;cursor:pointer;transition:transform .18s,box-shadow .22s,background .2s;white-space:nowrap}
  .btn-main{background:var(--em);color:#02150f;clip-path:polygon(0 0,calc(100% - 14px) 0,100% 14px,100% 100%,14px 100%,0 calc(100% - 14px));box-shadow:0 0 0 rgba(19,209,146,0)}
  .btn-main:hover,.btn-main:focus-visible{background:var(--em-hot);transform:translateY(-2px);box-shadow:0 14px 34px -12px rgba(19,209,146,.75)}
  .btn-ghost{background:transparent;border:1px solid var(--line-strong);color:var(--text);clip-path:var(--clip)}
  .btn-ghost:hover,.btn-ghost:focus-visible{border-color:var(--em);color:var(--em-hot);background:rgba(19,209,146,.07)}
  .head-cta{margin-left:6px}
  .burger{display:none;margin-left:auto;background:none;border:1px solid var(--line-strong);color:var(--text);width:44px;height:40px;align-items:center;justify-content:center;cursor:pointer}
  .burger span{display:block;width:18px;height:2px;background:var(--em);box-shadow:0 -6px 0 var(--em),0 6px 0 var(--em)}

  /* hero */
  .hero{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center;padding:74px 0 58px;position:relative;z-index:1}
  .hero h1{margin:16px 0 0;font-size:clamp(46px,7.2vw,90px);line-height:.94;font-weight:900;letter-spacing:-.045em}
  .hero h1 .yx{display:block;background:linear-gradient(96deg,#eafff6 6%,var(--em-hot) 42%,var(--em) 72%,#0a7a57 100%);-webkit-background-clip:text;background-clip:text;color:transparent}
